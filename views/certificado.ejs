<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap');
        /* Configuración de página */
        @page {
            size: A4 landscape;
            margin: 0;
        }

        body {
            margin: 0;
            padding: 0;
            font-family: 'Poppins', sans-serif; 
            background-color: #ffffff;
            color: #333;
        }

        .certificate {
            width: 297mm;
            height: 210mm;
            position: relative;
            box-sizing: border-box;
            /* SECCIÓN DEL FONDO ACTUALIZADA */
            background-image: url('<%= fondoSrc %>');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            overflow: hidden;
            padding-left: 12px;
        }

        /* Contenido Central */
        .content {
            padding: 25px 80px;
            text-align: left;
            display: flex;
            flex-direction: column;
            position: relative;
            z-index: 2;
            /* Asegura que el texto esté sobre el fondo */
        }

        .logo-container {
            text-align: right;
            margin-bottom: 5px;
        }

        .logo-img {
            width: 200px;
        }

        h1.main-title {
            color: #2c2a6b;
            font-size: 35px;
            margin: 0;
            font-weight: bold;
        }

        .text-info {
            font-size: 18.7px;
            margin-left: 2px;
            color: #2c2a6b;
            width: 575px;
            white-space: normal;
            word-wrap: break-word;
            overflow-wrap: break-word;
            box-sizing: border-box;
            line-height: 1.4;
        }

        .student-name {
            color: #2c2a6b;
            font-size: 34px;
            /* Tamaño máximo; el JS lo reduce si no cabe en una línea */
            font-weight: bold;
            margin: 1px 0;
            width: 575px;
            text-transform: uppercase;

            /* Fuerza una sola línea */
            white-space: nowrap;
            overflow: hidden;
            /* Fallback si el motor de PDF no ejecuta JS: corta con "..." en vez de desbordar */
            text-overflow: ellipsis;

            line-height: 1.2;
        }

        .course-name {
            color: #0d47a1;
            /* Un poco más pequeño que el nombre del alumno para jerarquía */
            font-size: clamp(18px, 4vw, 34px);
            font-weight: bold;
            margin: 1px 0;
            text-transform: uppercase;

            /* Permite 2 líneas */
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;

            line-height: 1.2;
            width: 100%;
        }

        .duration-info {
            color: #0d47a1;
            font-size: 17px;
            margin-top: 1px;
            line-height: 1.3;
        }

        /* --- SECCIÓN DE FIRMAS --- */
        .footer-container {
            position: absolute;
            bottom: 85px;
            left: 80px;
            right: 80px;
            z-index: 2;
        }

        .footer {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            width: 100%;
        }

        .signature-box {
            width: 250px;
            text-align: center;
            border-top: 1px solid #e67e22;
            position: relative;
            padding-top: 5px;
        }

        .signature-img {
            position: absolute;
            bottom: 35px;
            /* Subido para no tapar la línea ni el nombre */
            left: 50%;
            transform: translateX(-50%);
            height: 85px;
            width: auto;
            z-index: 10;
            /* Truco para que el fondo blanco de JPG/PNG se vuelva transparente */
            mix-blend-mode: multiply;
        }

        /* --- FIRMA DOCENTE: posición fija en mm respecto al fondo (.certificate) --- */
        .firma-docente-fija {
            position: absolute;
            left: 19mm;
            top: 156mm;
            width: 50mm;
            height: 11mm;
            z-index: 10;
            object-fit: contain;
            /* Mismo truco para que el fondo blanco del PNG/JPG se vea transparente */
            mix-blend-mode: multiply;
        }

        .sig-label {
            font-size: 11px;
            color: #e67e22;
            font-weight: bold;
            text-transform: uppercase;
        }

        .sig-name {
            font-size: 14px;
            color: #333;
            font-weight: bold;
        }

        .cert-code {
            color: #2c2a6b;
            text-align: center;

        }

        /* --- CÓDIGO DE CERTIFICACIÓN: posición fija en mm respecto al fondo (.certificate) --- */
        .cert-code-fija {
            position: absolute;
            left: 220mm;
            top: 186mm;
            text-align: center;
            z-index: 10;
            color: #2c2a6b;
        }

        .code-label {
            font-size: 11px;
            color: #2c2a6b;
      
        }

        .code-value {
            font-size: 13px;
            color: #2c2a6b;
        }

        .location-date {
            margin-top: 15px;
            font-size: 13px;
            color: #2c2a6b;
        }

        .qr-container {
            position: absolute;
            bottom: 170px;
            right: 100px;
            text-align: center;
            padding: 4px;
            z-index: 3;
        }

        .qr-img {
            width: 100px;
            height: 100px;
            display: block;
        }

        .nota-container {
            position: absolute;
            bottom: 40px;
            left: 0;
            right: 0;
            text-align: center;
            z-index: 3;
        }

        .nota-label {
            font-size: 18px;
            font-weight: bold;
            color: #2c2a6b;
            letter-spacing: 0.5px;
        }
    </style>
</head>

<body>
    <div class="certificate">
        <% if (firmaDocenteSrc && firmaDocenteSrc !=="" ) { %>
            <img src="<%= firmaDocenteSrc %>" class="firma-docente-fija">
            <% } %>
                <% if (qrSrc && qrSrc !=="" ) { %>
            <div class="qr-container">
                <img src="<%= qrSrc %>" class="qr-img">
            </div>
            <% } %>
                <div class="top-bar">
                    <div class="bar-navy"></div>
                    <div class="bar-blue"></div>
                    <div class="bar-orange"></div>
                </div>

                <div class="content">
                    <br><br>
                    <h1 class="main-title"></h1>
                    <br><br>
                    <!-- <div class="text-info">Otorgado a:</div> -->
                    <br><br><br><br>
                    <div class="text-info">Certifica a:</div>
                    <br>
                    <div class="student-name">
                        <%= nombreAlumno %>
                    </div>
                    <br>
                    <div class="text-info">por haber aprobado satisfactoriamente el curso de <strong><%= nombreCurso %></strong>, con una
                            duración de 
                                <%= creditos %>
                            horas <%= tipoHoras %>.<br>
                                Del <strong>
                                    <%= inicio %>
                                </strong> al <strong>
                                    <%= fin %>
                                </strong><br>

                    </div>
                </div>

                <div class="footer-container">
                    <div class="location-date">
                        Lima, <%= fechaEmision %>
                    </div>
                </div>

                <div class="cert-code cert-code-fija">
                    <div class="code-value">
                        <%= codigoNH %>
                    </div>
                </div>

                <% if (typeof nota !=="undefined" && nota && nota !=="" ) { %>
                    <div class="nota-container">
                        <div class="nota-label">NOTA: <%= nota %>
                        </div>
                    </div>
                    <% } %>
    </div>

    <script>
        (function () {
            function ajustarTextoAUnaLinea(selector, minFontSize) {
                var el = document.querySelector(selector);
                if (!el) return;

                var fontSize = parseFloat(window.getComputedStyle(el).fontSize);

                // Reduce el font-size de a 1px hasta que el texto quepa en una línea
                // o hasta llegar al tamaño mínimo permitido.
                while (el.scrollWidth > el.clientWidth && fontSize > minFontSize) {
                    fontSize -= 1;
                    el.style.fontSize = fontSize + 'px';
                }
            }

            ajustarTextoAUnaLinea('.student-name', 16);
        })();
    </script>
</body>

</html>