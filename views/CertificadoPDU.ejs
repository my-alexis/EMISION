<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <style>
        /* Configuración de página */
        @page {
            size: A4 landscape;
            margin: 0;
        }

        body {
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #ffffff;
            color: #333;
        }

        .certificate {
            width: 297mm;
            height: 210mm;
            position: relative;
            box-sizing: border-box;
            background-image: url('<%= fondoSrc %>');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            overflow: hidden;
        }

        /* Contenido Central */
        .content {
            padding: 25px 80px;
            text-align: left;
            display: flex;
            flex-direction: column;
            position: relative;
            z-index: 2;
        }

        .logo-container {
            text-align: right;
            margin-bottom: 5px;
        }

        .logo-img {
            width: 200px;
        }

        h1.main-title {
            color: #0d47a1;
            font-size: 35px;
            margin: 0;
            font-weight: bold;
        }

        .text-info {
            font-size: 16px;
            margin: 2px 0 0 0;
            color: #0d47a1;
        }

        .student-name {
            color: #e67e22;
            font-size: clamp(18px, 4.5vw, 34px);
            font-weight: bold;
            margin: 1px 0;
            text-transform: uppercase;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            line-height: 1.2;
            width: 100%;
            min-height: 1.2em;
        }

        .course-name {
            color: #0d47a1;
            font-size: clamp(18px, 4vw, 34px);
            font-weight: bold;
            margin: 1px 0;
            text-transform: uppercase;
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
            line-height: 1.2;
            width: 100%;
        }

        .duration-info {
            color: #0d47a1;
            font-size: 17px;
            margin-top: 1px;
            line-height: 1.3;
        }

        /* DISEÑO PDU + PERIODO A DOS COLUMNAS */
        .periodo-pdu-container {
            display: flex;
            
            align-items: flex-start;
            margin-top: 5px;
            color: #0d47a1;
            font-size: 15px;
        }

        .periodo-block strong.title {
            font-size: 16px;
        }

        .pdu-block {
            padding-left: 120px;
            
            font-size: 15px;
        }

        /* --- SECCIÓN DE FIRMAS --- */
        .footer-container {
            position: absolute;
            bottom: 85px;
            left: 80px;
            right: 80px;
            z-index: 2;
        }

        .footer {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            width: 100%;
        }

        .signature-box {
            width: 250px;
            text-align: center;
            border-top: 1px solid #e67e22;
            position: relative;
            padding-top: 5px;
        }

        .signature-img {
            position: absolute;
            bottom: 35px;
            left: 50%;
            transform: translateX(-50%);
            height: 85px;
            width: auto;
            z-index: 10;
            mix-blend-mode: multiply;
        }

        .sig-label {
            font-size: 11px;
            color: #e67e22;
            font-weight: bold;
            text-transform: uppercase;
        }

        .sig-name {
            font-size: 14px;
            color: #333;
            font-weight: bold;
        }

        .cert-code {
            text-align: right;
        }

        .code-label {
            font-size: 11px;
            color: #0d47a1;
            font-weight: bold;
        }

        .code-value {
            font-size: 13px;
            font-weight: bold;
        }

        .location-date {
            margin-top: 15px;
            font-size: 13px;
            color: #0d47a1;
        }

        .qr-container {
            position: absolute;
            bottom: 170px;
            right: 100px;
            text-align: center;
            padding: 4px;
            z-index: 3;
        }

        .qr-img {
            width: 100px;
            height: 100px;
            display: block;
        }

        .nota-container {
            position: absolute;
            bottom: 40px;
            left: 0;
            right: 0;
            text-align: center;
            z-index: 3;
        }

        .nota-label {
            font-size: 18px;
            font-weight: bold;
            color: #0d47a1;
            letter-spacing: 0.5px;
        }
    </style>
</head>

<body>
    <div class="certificate">
        <% if (qrSrc && qrSrc !=="" ) { %>
            <div class="qr-container">
                <img src="<%= qrSrc %>" class="qr-img">
            </div>
        <% } %>
        
        <div class="top-bar">
            <div class="bar-navy"></div>
            <div class="bar-blue"></div>
            <div class="bar-orange"></div>
        </div>

        <div class="content">
            <br><br><br><br>
            <h1 class="main-title">CERTIFICADO</h1>
            <br>
            <div class="student-name">
                <%= nombreAlumno %>
            </div>
            <br>
            <div class="text-info">Concluyó de manera satisfactoria el curso</div><br>
            <div class="course-name">
                <%= nombreCurso %>
            </div>
            <br>

            <div class="duration-info">
                con una duración de <strong><%= creditos %></strong> horas <%= tipoHoras %>
            </div>

            <div class="periodo-pdu-container">
                <div class="periodo-block">
                    <strong class="title">Periodo:</strong><br>
                    Inicio: <%= inicio %><br>
                    Fin: <%= fin %>
                </div>

                <% if (typeof pdu !== "undefined" && pdu !== "" && typeof codigoPDU !== "undefined" && codigoPDU !== "") { %>
                    <div class="pdu-block">
                        <br>
                        <strong>PDUs: <%= pdu %></strong><br>
                        <strong>Código: <%= codigoPDU %></strong>
                    </div>
                <% } %>
            </div>
        </div>

        <div class="footer-container">
            <div class="footer">

                <% if (firmaDocenteSrc && firmaDocenteSrc !=="" ) { %>
                    <div class="signature-box">
                        <img src="<%= firmaDocenteSrc %>" class="signature-img">
                        <div class="sig-label">Instructor</div>
                        <div class="sig-name">
                            <%= nombreDocente %>
                        </div>
                    </div>
                <% } %>

                <div class="signature-box">
                    <% if (firmaFijaSrc) { %>
                        <img src="<%= firmaFijaSrc %>" class="signature-img">
                    <% } %>
                    <div class="sig-label">DIRECTOR ACADÉMICO</div>
                    <div class="sig-name">ENRIQUE HUAMAN FARFAN</div>
                </div>

                <div class="cert-code">
                    <div class="code-label">CÓDIGO DE CERTIFICADO</div>
                    <div class="code-value">
                        <%= codigoNH %>
                    </div>
                </div>
            </div>
            <br>
            <div class="location-date">
                Lima, <%= fechaEmision %>
            </div>
        </div>

        <% if (typeof nota !=="undefined" && nota && nota !=="" ) { %>
            <div class="nota-container">
                <div class="nota-label">NOTA: <%= nota %></div>
            </div>
        <% } %>
    </div>
</body>

</html>